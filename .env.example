# Copy this file to .env, which git ignores, and fill in your own keys. Never commit .env.

# The Red team page and eval/generate_essays.py write with Gemini.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: keys from other Google accounts or Cloud projects, comma-separated. The Red team page uses
# each model on every key before it moves to the next model. Keys from one project share one allowance.
GEMINI_API_KEYS=

# Optional: more models for the Red team page (Model & connection) and the benchmarks (--provider).
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenRouter skips hosts that keep or train on prompts. Set to allow to use them too; many free models need it.
# OPENROUTER_DATA_COLLECTION=allow

# Only align_engine.py needs this; it drafts with Claude.
ANTHROPIC_API_KEY=

# Optional, private runs only: when the hosted models fail, the generators try the Gemini website, signed in with
# the session in your Firefox (unofficial client gemini_webapi, with browser-cookie3). Set to on to allow it.
# GEMINI_WEB_FALLBACK=on
